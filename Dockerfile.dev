# Development Dockerfile
FROM node:22-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
# If using yarn:
# COPY package.json yarn.lock ./

# Install dependencies
RUN npm install
# If using yarn:
# RUN yarn install

# Copy source code
COPY . .

# Expose the Vite dev server port
EXPOSE 5173

# Start development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
# If using yarn:
# CMD ["yarn", "dev", "--host", "0.0.0.0"]